import numpy as np
from scipy.linalg import expm
from functools import reduce

def charger_reseau_hopfield_hermitien(N, params_noeuds=None, W_custom=None):
    """ Initialise le réseau Hermitien (W, M_noeuds, Psi_0) """
    if params_noeuds is None:
        vecs = np.random.randn(N, 3)
        vecs /= np.linalg.norm(vecs, axis=1, keepdims=True)
        params_noeuds = np.column_stack([np.ones(N), vecs])

    a0, ax, ay, az = params_noeuds[:, 0], params_noeuds[:, 1], params_noeuds[:, 2], params_noeuds[:, 3]

    M = np.zeros((N, 2, 2), dtype=complex)
    M[:, 0, 0] = a0 + az
    M[:, 0, 1] = ax - 1j * ay
    M[:, 1, 0] = ax + 1j * ay
    M[:, 1, 1] = a0 - az

    psi_locaux = []
    for j in range(N):
        vals, vecs = np.linalg.eigh(M[j])
        psi_locaux.append(vecs[:, -1])

    Psi_0 = reduce(np.kron, psi_locaux)
    Psi_0 /= np.linalg.norm(Psi_0)

    if W_custom is None:
        A = np.random.randn(N, N) + 1j * np.random.randn(N, N)
        W_custom = (A + A.conj().T) / (2 * np.sqrt(N))

    return W_custom, M, Psi_0


def trace_partielle_noeud(Psi, target_idx, N):
    """
    Extrait la matrice 2x2 réduite du nœud `target_idx`
    à partir du vecteur d'état global Psi (dimension 2^N) via Einsum.
    """
    rho_global = np.outer(Psi, Psi.conj())
    
    left_dim = 2**target_idx
    right_dim = 2**(N - 1 - target_idx)
    
    # Reshape pour isoler le sous-espace du nœud cible
    rho_reshaped = rho_global.reshape((left_dim, 2, right_dim, left_dim, 2, right_dim))
    
    # Contraction d'indices (trace partielle sur tous les autres nœuds)
    rho_2x2 = np.einsum('i a k i b k -> a b', rho_reshaped)
    return rho_2x2


def simuler_et_sauvegarder_trajectoire(N=3, t_max=5.0, dt=0.05, filename="trajectoire_hopfield.npz"):
    """
    Simule l'évolution continue et enregistre à chaque pas dt :
    - L'état global Psi(t) -> Shape: (T_steps, 2^N)
    - Le tenseur des N matrices 2x2 locales -> Shape: (T_steps, N, 2, 2)
    """
    W, M_initial, Psi_0 = charger_reseau_hopfield_hermitien(N)
    dim_global = 2**N

    # 1. Construction du Hamiltonien global H
    sigma_z = np.array([[1, 0], [0, -1]], dtype=complex)
    I2 = np.eye(2, dtype=complex)

    def op_noeud(op, idx):
        return reduce(np.kron, [op if i == idx else I2 for i in range(N)])

    H_global = np.zeros((dim_global, dim_global), dtype=complex)
    for j in range(N):
        for k in range(N):
            if j != k:
                H_global += W[j, k] * (op_noeud(sigma_z, j) @ op_noeud(sigma_z, k))

    # 2. Opérateur d'évolution élémentaire U(dt)
    U_dt = expm(-1j * H_global * dt)

    # 3. Grille temporelle
    temps = np.arange(0.0, t_max + dt, dt)
    T_steps = len(temps)

    # 4. Tableaux de sauvegarde (Tenseurs d'historique)
    historique_Psi = np.zeros((T_steps, dim_global), dtype=complex)
    historique_M_noeuds = np.zeros((T_steps, N, 2, 2), dtype=complex)

    # 5. Boucle d'intégration temporelle
    Psi_t = Psi_0.copy()

    for t_idx, t in enumerate(temps):
        # Sauvegarde de l'état global
        historique_Psi[t_idx] = Psi_t

        # Calcul vectorisé des matrices 2x2 réduites pour chaque nœud
        for j in range(N):
            historique_M_noeuds[t_idx, j] = trace_partielle_noeud(Psi_t, j, N)

        # Évolution d'un pas dt : Psi(t + dt) = U(dt) * Psi(t)
        Psi_t = U_dt @ Psi_t

    # 6. Sauvegarde compressée sur disque
    np.savez_compressed(
        filename,
        temps=temps,
        W=W,
        M_initial=M_initial,
        historique_Psi=historique_Psi,
        historique_M_noeuds=historique_M_noeuds
    )

    print(f"=== SAUVEGARDE RÉUSSIE ===")
    print(f"Fichier : {filename}")
    print(f"Nombre de pas de temps : {T_steps} (dt = {dt}s, t_max = {t_max}s)")
    print(f"Dimension Tenseur Global Psi(t)    : {historique_Psi.shape}")
    print(f"Dimension Tenseur Nodal M(t, j)   : {historique_M_noeuds.shape}")
    
    return filename


def recharger_trajectoire(filename="trajectoire_hopfield.npz"):
    """ Exemple de rechargement des données enregistrées """
    data = np.load(filename)
    temps = data['temps']
    M_t = data['historique_M_noeuds']
    W = data['W']
    
    print(f"\n=== DONNÉES RECHARGÉES DU FICHIER ===")
    print(f"Instants enregistrés : {len(temps)}")
    print(f"Matrice 2x2 du Nœud 0 à t=0 :\n{np.round(M_t[0, 0], 3)}")
    print(f"Matrice 2x2 du Nœud 0 à t=final :\n{np.round(M_t[-1, 0], 3)}")


if __name__ == "__main__":
    # Exécution de la simulation et sauvegarde
    fichier_out = simuler_et_sauvegarder_trajectoire(N=3, t_max=4.0, dt=0.1)
    
    # Vérification de la lecture
    recharger_trajectoire(fichier_out)
