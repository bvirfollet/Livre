import numpy as np
from scipy.linalg import expm
from functools import reduce

def charger_reseau_hopfield_hermitien(N, params_noeuds=None, W_custom=None):
    """
    Charge en 1 coup :
    1. La matrice d'interaction W (N x N)
    2. Le tenseur M (N x 2 x 2) contenant toutes les matrices 2x2 des nœuds
    3. L'état global |Psi_0> dans le produit tensoriel C^(2^N)
    """
    # -------------------------------------------------------------
    # A. CHARGEMENT VECTORISÉ DES MATRICES 2x2 DES NŒUDS
    # -------------------------------------------------------------
    if params_noeuds is None:
        # Génération aléatoire de N quadruplets (a0, ax, ay, az) sur S^2
        # a0 = 1 (normalisé), (ax, ay, az) = vecteur unitaire 3D
        vecs = np.random.randn(N, 3)
        vecs /= np.linalg.norm(vecs, axis=1, keepdims=True)
        params_noeuds = np.column_stack([np.ones(N), vecs]) # Shape: (N, 4)

    a0 = params_noeuds[:, 0]
    ax = params_noeuds[:, 1]
    ay = params_noeuds[:, 2]
    az = params_noeuds[:, 3]

    # Construction du tenseur (N, 2, 2) en UNE SEULE OPÉRATION
    M = np.zeros((N, 2, 2), dtype=complex)
    M[:, 0, 0] = a0 + az
    M[:, 0, 1] = ax - 1j * ay
    M[:, 1, 0] = ax + 1j * ay
    M[:, 1, 1] = a0 - az

    # -------------------------------------------------------------
    # B. ASSEMBLAGE DANS L'ESPACE DE HILBERT GLOBAL C^(2^N)
    # -------------------------------------------------------------
    # Extraction des vecteurs d'état 2D |psi_j> (vecteur propre dominant de M_j)
    psi_locaux = []
    for j in range(N):
        vals, vecs = np.linalg.eigh(M[j])
        psi_locaux.append(vecs[:, -1])  # État propre d'énergie maximale

    # Produit tensoriel global: |Psi_0> = |psi_1> (x) |psi_2> (x) ... (x) |psi_N>
    Psi_0 = reduce(np.kron, psi_locaux)
    Psi_0 /= np.linalg.norm(Psi_0)

    # -------------------------------------------------------------
    # C. MATRICE SYNAPTIQUE W (N x N)
    # -------------------------------------------------------------
    if W_custom is None:
        A = np.random.randn(N, N) + 1j * np.random.randn(N, N)
        W_custom = (A + A.conj().T) / (2 * np.sqrt(N))

    return W_custom, M, Psi_0


def simuler_leggett_garg_charge(N=3, n_trials=30000, tau=0.3):
    # 1. Chargement instantané des structures
    W, M_noeuds, Psi_0 = charger_reseau_hopfield_hermitien(N)

    dim_global = 2**N
    
    # Hamiltonien d'interaction dans le produit tensoriel
    # H_eff = sum_jk W_jk (sigma_z_j (x) sigma_z_k)
    sigma_z = np.array([[1, 0], [0, -1]], dtype=complex)
    I2 = np.eye(2, dtype=complex)

    def op_nœud(op, target_idx):
        ops = [op if i == target_idx else I2 for i in range(N)]
        return reduce(np.kron, ops)

    H_global = np.zeros((dim_global, dim_global), dtype=complex)
    for j in range(N):
        for k in range(N):
            if j != k:
                H_global += W[j, k] * (op_nœud(sigma_z, j) @ op_nœud(sigma_z, k))

    U_tau = expm(-1j * H_global * tau)

    # Projecteurs sur le premier nœud
    P1_plus = op_nœud(np.array([[1, 0], [0, 0]]), 0)
    P1_minus = np.eye(dim_global) - P1_plus

    def mesurer_Q1(psi):
        prob = np.real(np.vdot(psi, P1_plus @ psi))
        prob = np.clip(prob, 0.0, 1.0)
        if np.random.rand() < prob:
            proj = P1_plus @ psi
            return +1, proj / np.linalg.norm(proj)
        else:
            proj = P1_minus @ psi
            return -1, proj / np.linalg.norm(proj)

    # --- Séquences de mesure Leggett-Garg ---
    def evaluer_correl(m_t1, m_t2):
        q1_list, q2_list = [], []
        for _ in range(n_trials):
            psi = Psi_0.copy()
            if m_t1:
                psi = U_tau @ psi
                q1, psi = mesurer_Q1(psi)
            else:
                psi = U_tau @ psi
                q1 = 0
            
            psi = U_tau @ psi
            if m_t2:
                q2, psi = mesurer_Q1(psi)
            else:
                q2 = 0
            
            if m_t1 and m_t2:
                q1_list.append(q1)
                q2_list.append(q2)
        return np.mean(np.array(q1_list) * np.array(q2_list))

    # Calcul de C12, C23 et C13
    C12 = evaluer_correl(m_t1=True, m_t2=True)
    
    # C23
    q2_23, q3_23 = [], []
    for _ in range(n_trials):
        psi = U_tau @ (U_tau @ Psi_0)
        q2, psi = mesurer_Q1(psi)
        psi = U_tau @ psi
        q3, _ = mesurer_Q1(psi)
        q2_23.append(q2); q3_23.append(q3)
    C23 = np.mean(np.array(q2_23) * np.array(q3_23))

    # C13 (Sans mesure intermédiaire t2)
    q1_13, q3_13 = [], []
    for _ in range(n_trials):
        psi = U_tau @ Psi_0
        q1, psi = mesurer_Q1(psi)
        psi = (U_tau @ U_tau) @ psi  # Évolution continue à t2
        q3, _ = mesurer_Q1(psi)
        q1_13.append(q1); q3_13.append(q3)
    C13 = np.mean(np.array(q1_13) * np.array(q3_13))

    K = C12 + C23 - C13

    print(f"=== LEGGETT-GARG SUR HILBERT TENSORIEL (N={N} qubits) ===")
    print(f"Forme du tenseur d'états M_noeuds : {M_noeuds.shape}")
    print(f"C12 : {C12:+.4f} | C23 : {C23:+.4f} | C13 : {C13:+.4f}")
    print(f"Indice K = {K:.4f} (Borne classique: K <= 1.0)")
    if K > 1.0:
        print(f"VIOLATION : K dépasse la borne classique de {K - 1.0:.4f}")

if __name__ == "__main__":
    simuler_leggett_garg_charge(N=3, n_trials=20000, tau=0.35)
