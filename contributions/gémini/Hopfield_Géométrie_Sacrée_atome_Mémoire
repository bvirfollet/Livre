import numpy as np
import matplotlib.pyplot as plt
from functools import reduce

def generer_etats_ancres(N):
    """ Génère deux états ancres purs et orthogonaux |A> et |B> dans C^(2^N) """
    dim = 2**N
    # État |A> : Produit tensoriel de |0>
    psi_A = np.zeros(dim, dtype=complex)
    psi_A[0] = 1.0

    # État |B> : Produit tensoriel de |1>
    psi_B = np.zeros(dim, dtype=complex)
    psi_B[-1] = 1.0

    return psi_A, psi_B


def analyse_monte_carlo_franges(N=3, n_phi=60, n_mc_trials=20000, tracer_graphique=True):
    """
    Exécute l'analyse Monte-Carlo pour extraire les franges d'interférence 
    et le contraste de visibilité V.
    """
    np.random.seed(42)
    dim = 2**N
    psi_A, psi_B = generer_etats_ancres(N)

    # 1. Construction de la Superposition Cohérente |Psi_sup>
    psi_sup = (psi_A + psi_B) / np.sqrt(2)

    # 2. Grille d'angles de phase phi in [0, 2*pi]
    phi_vals = np.linspace(0, 2 * np.pi, n_phi)

    p_superposition_mc = np.zeros(n_phi)
    p_melange_mc = np.zeros(n_phi)

    print(f"=== ANALYSE MONTE-CARLO DES FRANGES DE VISIBILITÉ (N={N} nœuds) ===")
    print(f"Nombre de tirages Monte-Carlo par pas d'angle : {n_mc_trials}")
    print("Simulation en cours...\n")

    for i, phi in enumerate(phi_vals):
        # État d'analyse / Filtre d'interférence : |Phi(phi)> = (|A> + e^(i*phi)|B>) / sqrt(2)
        phi_state = (psi_A + np.exp(1j * phi) * psi_B) / np.sqrt(2)

        # Probabilités théoriques
        prob_sup_exact = np.abs(np.vdot(phi_state, psi_sup))**2
        prob_A = np.abs(np.vdot(phi_state, psi_A))**2
        prob_B = np.abs(np.vdot(phi_state, psi_B))**2

        # --- A. Tirages Monte-Carlo : SUPERPOSITION ---
        # Succès = 1 si la mesure projective valide le filtre phi
        tirages_sup = np.random.rand(n_mc_trials) < prob_sup_exact
        p_superposition_mc[i] = np.mean(tirages_sup)

        # --- B. Tirages Monte-Carlo : MÉRANGE CLASSIQUE ---
        # 50% du temps l'état est A, 50% du temps l'état est B (choix stochastique préalable)
        choix_etat = np.random.rand(n_mc_trials) < 0.5
        prob_effectives = np.where(choix_etat, prob_A, prob_B)
        tirages_mix = np.random.rand(n_mc_trials) < prob_effectives
        p_melange_mc[i] = np.mean(tirages_mix)

    # 3. Calcul du Contraste de Visibilité (Visibility V)
    p_max_sup, p_min_sup = np.max(p_superposition_mc), np.min(p_superposition_mc)
    v_superposition = (p_max_sup - p_min_sup) / (p_max_sup + p_min_sup + 1e-12)

    p_max_mix, p_min_mix = np.max(p_melange_mc), np.min(p_melange_mc)
    v_melange = (p_max_mix - p_min_mix) / (p_max_mix + p_min_mix + 1e-12)

    print("=== RÉSULTATS DES MESURES MONTE-CARLO ===")
    print(f"CAS 1 : Superposition d'états (Coherence de phase)")
    print(f"  • P_max = {p_max_sup:.4f} | P_min = {p_min_sup:.4f}")
    print(f"  • Contraste de Visibilité V_sup = {v_superposition:.4f} (Visibilité maximale = 1.0)")
    print(f"\nCAS 2 : Mélange Classique (Absence de phase)")
    print(f"  • P_max = {p_max_mix:.4f} | P_min = {p_min_mix:.4f}")
    print(f"  • Contraste de Visibilité V_mix = {v_melange:.4f} (Visibilité nulle = 0.0)")

    # 4. Tracé Graphique (si Matplotlib est disponible)
    if tracer_graphique:
        plt.figure(figsize=(10, 6))
        plt.plot(phi_vals, p_superposition_mc, 'ro-', label=f'Superposition Cohérente (Monte-Carlo) | $\mathcal{{V}}$ = {v_superposition:.3f}', alpha=0.8)
        plt.plot(phi_vals, p_melange_mc, 'bs--', label=f'Mélange Classique / Bruit (Monte-Carlo) | $\mathcal{{V}}$ = {v_melange:.3f}', alpha=0.8)
        
        # Courbe théorique idéale pour comparaison
        phi_dense = np.linspace(0, 2*np.pi, 200)
        plt.plot(phi_dense, (1 + np.cos(phi_dense))/2, 'k:', label='Frange Théorique Parfaite $\cos^2(\phi/2)$')

        plt.title(f"Mise en évidence des Franges d'Interférence par Monte-Carlo (N={N} nœuds)", fontsize=13)
        plt.xlabel("Angle de Phase de Projection $\phi$ (radians)", fontsize=11)
        plt.ylabel("Densité de Probabilité de Détection $P(\phi)$", fontsize=11)
        plt.grid(True, linestyle='--', alpha=0.6)
        plt.legend(fontsize=10, loc='upper right')
        plt.tight_layout()
        plt.savefig("franges_visibilite_monte_carlo.png", dpi=300)
        print("\nGraphique sauvegardé sous : 'franges_visibilite_monte_carlo.png'")
        plt.show()

    return phi_vals, p_superposition_mc, p_melange_mc


if __name__ == "__main__":
    # Exécution de l'analyse Monte-Carlo
    analyse_monte_carlo_franges(N=3, n_phi=50, n_mc_trials=30000, tracer_graphique=True)
