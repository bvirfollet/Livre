import numpy as np
from scipy.linalg import expm

def simuler_leggett_garg_hopfield(N=4, n_trials=50000, tau=0.4):
    """
    Simule une violation de l'inégalité de Leggett-Garg dans un réseau 
    de Hopfield Hermitien complexe de dimension N.
    """
    np.random.seed(42)
    
    # 1. Matrice synaptique Hermitienne W (N x N)
    A = np.random.randn(N, N) + 1j * np.random.randn(N, N)
    W = (A + A.conj().T) / (2 * np.sqrt(N))  # W = W_dag
    
    # 2. Opérateur d'évolution unitaire U(tau) = exp(-i * W * tau)
    U_tau = expm(-1j * W * tau)
    
    # 3. Projecteurs de mesure sur le premier nœud (Observable Q in {-1, +1})
    P_plus = np.zeros((N, N), dtype=complex)
    P_plus[0, 0] = 1.0  # Projection sur la présence du pôle 1
    P_minus = np.eye(N, dtype=complex) - P_plus

    def mesurer_Q(psi):
        """Réalise le second effondrement (Mesure projective de Lüders)"""
        prob_plus = np.real(np.vdot(psi, P_plus @ psi))
        prob_plus = np.clip(prob_plus, 0.0, 1.0)
        
        if np.random.rand() < prob_plus:
            collapsed = P_plus @ psi
            norm = np.linalg.norm(collapsed)
            return +1, collapsed / norm if norm > 0 else psi
        else:
            collapsed = P_minus @ psi
            norm = np.linalg.norm(collapsed)
            return -1, collapsed / norm if norm > 0 else psi

    # État initial en superposition cohérente uniforme sur tous les nœuds
    psi_0 = np.ones(N, dtype=complex) / np.sqrt(N)

    # --- Séquence 1 : Mesure à t1 puis t2 (Calcul de C12) ---
    q1_12, q2_12 = [], []
    for _ in range(n_trials):
        psi_t1 = U_tau @ psi_0
        q1, psi_after_1 = mesurer_Q(psi_t1)  # 1er effondrement
        psi_t2 = U_tau @ psi_after_1
        q2, _ = mesurer_Q(psi_t2)             # 2ème effondrement
        q1_12.append(q1)
        q2_12.append(q2)
    C12 = np.mean(np.array(q1_12) * np.array(q2_12))

    # --- Séquence 2 : Mesure à t2 puis t3 (Calcul de C23) ---
    q2_23, q3_23 = [], []
    for _ in range(n_trials):
        psi_t2 = U_tau @ (U_tau @ psi_0)     # Évolution jusqu'à t2
        q2, psi_after_2 = mesurer_Q(psi_t2)  # Mesure à t2
        psi_t3 = U_tau @ psi_after_2
        q3, _ = mesurer_Q(psi_t3)             # Mesure à t3
        q2_23.append(q2)
        q3_23.append(q3)
    C23 = np.mean(np.array(q2_23) * np.array(q3_23))

    # --- Séquence 3 : Mesure à t1 puis t3 SANS mesure à t2 (Calcul de C13) ---
    q1_13, q3_13 = [], []
    for _ in range(n_trials):
        psi_t1 = U_tau @ psi_0
        q1, psi_after_1 = mesurer_Q(psi_t1)  # Mesure à t1
        # Évolution directe t1 -> t3 (la superposition est maintenue à t2)
        psi_t3 = (U_tau @ U_tau) @ psi_after_1
        q3, _ = mesurer_Q(psi_t3)             # Mesure à t3
        q1_13.append(q1)
        q3_13.append(q3)
    C13 = np.mean(np.array(q1_13) * np.array(q3_13))

    # Indice K de Leggett-Garg
    K = C12 + C23 - C13

    # Affichage des résultats
    print(f"=== TEST DE LEGGETT-GARG (N = {N} nœuds) ===")
    print(f"C_12 (t1 -> t2) : {C12:+.4f}")
    print(f"C_23 (t2 -> t3) : {C23:+.4f}")
    print(f"C_13 (t1 -> t3) : {C13:+.4f}")
    print(f"----------------------------------------")
    print(f"Indice K = C_12 + C_23 - C_13 = {K:.4f}")
    print(f"Borne macro-réaliste classique : K <= 1.0000")
    print(f"----------------------------------------")
    if K > 1.0:
        print(f"VIOLATION : K dépasse la borne de {K - 1.0:.4f}.")
        print("-> Preuve statistique irréfutable de la superposition de phase.")
    else:
        print("Comportement classique (pas de violation observée).")

if __name__ == "__main__":
    # Test avec N=4 nœuds (modifiable à N=3, N=5, etc.)
    simuler_leggett_garg_hopfield(N=4, n_trials=50000, tau=0.4)
